    "@next/mdx": "^16.2.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/core": "3.24.0",
    "@tiptap/extension-image": "3.24.0",
    "@tiptap/extension-list": "3.24.0",
    "@tiptap/extension-table": "3.24.0",
