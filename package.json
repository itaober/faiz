{
  "name": "faiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 1999",
    "dev:worker": "mkdir -p out && wrangler dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "simple-git-hooks",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --write --staged --no-errors-on-unmatched",
    "commit-msg": "npx --no-install commitlint --edit $1"
  },
