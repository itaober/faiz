    "gray-matter": "^4.0.3",
    "lucide-react": "^0.539.0",
    "marked": "^16.3.0",
    "minisearch": "^7.2.0",
    "motion": "^12.26.2",
    "next": "16.2.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
