# Copy to .env.local. `pnpm setup:cloudflare` prints every value; the local block uses the -dev bucket and folder.

# Cloudflare account ID; the R2 endpoint is https://<id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
# Access Key ID of an R2 API token with Object Read & Write on the content bucket, its -dev twin and the assets bucket.
R2_ACCESS_KEY_ID=
# Secret Access Key of that token; shown once when the token is created.
R2_SECRET_ACCESS_KEY=
# Public bucket that holds the images, can be shared by several sites.
R2_ASSETS_BUCKET=
# Private bucket that holds this site's posts, pages, memos and records.
R2_CONTENT_BUCKET=
# Public URL of this site's folder in the assets bucket, e.g. https://assets.example.com/blog.
NEXT_PUBLIC_ASSETS_URL=
# Edit sign-in key, 32 random bytes: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
EDIT_KEY=
# Optional locally; signs favicon URLs for link previews. Any random string: openssl rand -base64 32
LINK_PREVIEW_SIGNING_SECRET=
